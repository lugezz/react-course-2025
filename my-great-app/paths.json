{
  "compilerOptions": {
    "baseUrl": ".",
    "esModuleInterop": true,
    "paths": {
      "@app/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@config": ["src/config.ts"],
      "@config/*": ["src/config/*"],
      "@modules/*": ["src/modules/*"],
      "@pages/*": ["src/pages/*"],
      "@store/*": ["src/store/*"],
      "@store": ["src/store"],
      "@utils/*": ["src/utils/*"]
    }
  }
}